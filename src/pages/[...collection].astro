---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { collections, productsIn } from '../lib/wp';

export async function getStaticPaths() {
  return Promise.all(
    collections.map(async (c) => ({ params: { collection: c.path }, props: { c, products: await productsIn(c.categorySlug) } })),
  );
}
const { c, products } = Astro.props;
const top = c.path.split('/')[0];
const parent = c.path.includes('/') ? collections.find((x) => x.path === top) : undefined;
const subs = parent ? [] : collections.filter((x) => x.path.startsWith(`${top}/`));
---
<Base title={c.title} description={c.blurb}>
  <header class="page-head">
    <div class="frame">
      {parent && <p class="crumb"><a href={`/${parent.path}/`}>{parent.title}</a></p>}
      <h1>{c.title}</h1>
      <p>{c.blurb}</p>
      {subs.length > 0 && <ul class="chips">{subs.map((s) => <li><a href={`/${s.path}/`}>{s.title}</a></li>)}</ul>}
    </div>
  </header>
  <section class="band">
    <div class="frame">
      <p class="count pad">{products.length} {products.length === 1 ? 'product' : 'products'}</p>
      <div class="grid4">{products.map((p) => <ProductCard product={p} />)}</div>
    </div>
  </section>
</Base>
<style>
  .band { padding-top: 32px; }
  .count { margin: 0 0 20px; color: var(--muted); }
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 10px; margin: 28px 0 0; padding: 0; }
  .chips a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border: 2px solid var(--white); border-radius: 999px; text-decoration: none; font-weight: 600; }
  .chips a:hover { background: var(--yellow); border-color: var(--yellow); color: var(--ink); }
</style>
