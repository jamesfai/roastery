---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getProducts, priceLabel, plain, wcUrl, collections } from '../../lib/wp';

export async function getStaticPaths() {
  const all = await getProducts();
  return all.map((p) => ({ params: { slug: p.slug }, props: { p, related: all.filter((r) => r.id !== p.id && r.categories.some((c) => p.categories.some((pc) => pc.id === c.id && !['retail', 'wholesale'].includes(c.slug)))).slice(0, 4) } }));
}
const { p, related } = Astro.props;
const simple = p.type === 'simple' && p.is_purchasable;
const crumbCat = p.categories.map((c) => collections.find((x) => x.categorySlug === c.slug)).filter((x) => !!x).sort((a, b) => b!.path.length - a!.path.length)[0];
---
<Base title={p.name} description={plain(p.short_description).slice(0, 160)} image={p.images[0]?.src}>
  <div class="frame pad">
    <div class="detail">
      <div class="gallery">
        <img class="main" src={p.images[0].src} alt={p.images[0].alt || p.name} width="900" height="900" />
        {p.images.length > 1 && <div class="thumbs">{p.images.slice(1).map((i) => <img src={i.thumbnail} alt={i.alt || p.name} loading="lazy" width="96" height="96" />)}</div>}
      </div>
      <div class="info">
        {crumbCat && <p class="crumb on-light"><a href={`/${crumbCat.path}/`}>{crumbCat.title}</a></p>}
        <h1>{p.name}</h1>
        <p class="price">{priceLabel(p)}</p>
        <div class="short" set:html={p.short_description} />
        {p.attributes.length > 0 && (
          <dl>{p.attributes.map((a) => <><dt>{a.name}</dt><dd>{a.terms.map((t) => t.name).join(', ')}</dd></>)}</dl>
        )}
        {!p.is_in_stock ? <p class="out">Currently out of stock</p> : simple
          ? <a class="btn" href={wcUrl.addToCart(p.id)}>Add to cart</a>
          : <a class="btn" href={p.permalink}>Choose size and grind</a>}
        <p class="note muted">{simple ? 'Adds to your cart and continues at our secure checkout.' : 'Pick your size and grind on our secure store page.'}</p>
      </div>
    </div>
  </div>
  {p.description && (
    <section class="band cream"><div class="frame pad"><div class="prose" set:html={p.description} /></div></section>
  )}
  {related.length > 0 && (
    <section class="band cream">
      <div class="frame">
        <h2 class="pad rel-h">You may also like</h2>
        <div class="grid4">{related.map((r) => <ProductCard product={r} />)}</div>
      </div>
    </section>
  )}
</Base>
<style>
  .detail { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 5vw, 64px); align-items: start; padding: clamp(28px, 5vw, 56px) 0; }
  .crumb.on-light { color: var(--muted); }
  .gallery { background: var(--mist); border-radius: var(--radius); overflow: hidden; }
  .main { width: 100%; height: auto; mix-blend-mode: multiply; }
  .thumbs { display: flex; gap: 8px; padding: 12px; } .thumbs img { width: 72px; height: 72px; object-fit: cover; border: 1px solid var(--ln); }
  .info h1 { font-size: clamp(2.2rem, 4.5vw, 3.4rem); }
  .price { font-size: 1.5rem; font-weight: 600; margin: 0 0 1.2rem; }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 8px 24px; margin: 24px 0; padding: 16px 0; border-block: 1px solid var(--ln); }
  dt { font-weight: 600; } dd { margin: 0; }
  .note { font-size: .85rem; margin-top: 12px; } .out { font-weight: 600; }
  .band { padding: clamp(48px, 7vw, 88px) 0; }
  .band.cream { padding: 0; } .rel-h { padding-top: clamp(48px, 7vw, 80px); padding-bottom: 32px; margin: 0; }
  .band.cream .grid4 { padding-bottom: clamp(48px, 7vw, 80px); }
  @media (max-width: 800px) { .detail { grid-template-columns: 1fr; } }
</style>
