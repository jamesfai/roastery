---
import Base from '../../layouts/Base.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getPosts, getPostCategories } from '../../lib/wp';

const posts = await getPosts();
const cats = await getPostCategories();
const [lead, ...rest] = posts;
---
<Base title="The Roast Journal" description="Stories, brewing tips and news from Daily Grind Roastery.">
  <header class="page-head">
    <div class="frame">
      <h1>The Roast Journal</h1>
      <p>Stories, brewing tips and news from the roastery.</p>
    </div>
  </header>
  <section class="band">
    <div class="frame">
      {cats.length > 0 && (
        <nav class="chips pad" aria-label="Article categories">
          <a href="/blogs/" aria-current="page">All</a>
          {cats.map((c) => <a href={`/blogs/category/${c.slug}/`}>{c.name}</a>)}
        </nav>
      )}
      {posts.length === 0 ? (
        <p class="pad empty">No articles yet. Check back soon, or <a href="/coffee-beans-retail/">browse our coffee</a>.</p>
      ) : (
        <>
          <div class="pad lead"><BlogCard post={lead} featured /></div>
          {rest.length > 0 && <div class="grid3">{rest.map((p) => <BlogCard post={p} />)}</div>}
        </>
      )}
    </div>
  </section>
</Base>
<style>
  .band { padding-top: 40px; }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 32px; }
  .chips a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border: 2px solid var(--ink); border-radius: 999px; text-decoration: none; font-weight: 600; }
  .chips a:hover, .chips a[aria-current] { background: var(--ink); color: var(--yellow); }
  .lead { margin-bottom: 24px; }
  .empty { font-size: 1.1rem; }
</style>
