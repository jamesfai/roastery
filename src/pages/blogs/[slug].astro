---
import Base from '../../layouts/Base.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getPosts, formatDate } from '../../lib/wp';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => {
    const catSlugs = post.categories.map((c) => c.slug);
    const related = posts.filter((p) => p.id !== post.id && p.categories.some((c) => catSlugs.includes(c.slug)));
    const more = (related.length >= 3 ? related : [...related, ...posts.filter((p) => p.id !== post.id && !related.includes(p))]).slice(0, 3);
    return { params: { slug: post.slug }, props: { post, more, newer: posts[i - 1], older: posts[i + 1] } };
  });
}
const { post, more, newer, older } = Astro.props;
---
<Base title={post.title} description={post.excerpt.slice(0, 160)} image={post.image?.src}>
  <header class="page-head">
    <div class="frame narrow">
      <p class="crumb"><a href="/blogs/">The Roast Journal</a></p>
      <h1>{post.title}</h1>
      <p class="meta">
        {post.categories[0] && <a class="tag" href={`/blogs/category/${post.categories[0].slug}/`}>{post.categories[0].name}</a>}
        <time datetime={post.date}>{formatDate(post.date)}</time>
        <span>{post.readMinutes} min read</span>
      </p>
    </div>
  </header>
  <article class="band post">
    <div class="frame pad narrow">
      {post.image && <img class="hero-img" src={post.image.src} alt={post.image.alt} width="1000" height="600" />}
      <div class="prose" set:html={post.content} />
      <nav class="pager" aria-label="More articles">
        {older ? <a href={`/blogs/${older.slug}/`}><small>Older</small><span>{older.title}</span></a> : <span />}
        {newer ? <a class="r" href={`/blogs/${newer.slug}/`}><small>Newer</small><span>{newer.title}</span></a> : <span />}
      </nav>
    </div>
  </article>
  {more.length > 0 && (
    <section class="band cream">
      <div class="frame">
        <h2 class="pad">Keep reading</h2>
        <div class="grid3">{more.map((p) => <BlogCard post={p} />)}</div>
      </div>
    </section>
  )}
</Base>
<style>
  .narrow { max-width: 860px; }
  .page-head .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin-top: 20px; color: var(--muted); font-size: .95rem; }
  .page-head .tag { text-decoration: none; }
  .post { padding-top: 0; }
  .hero-img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius); margin: 32px 0 40px; }
  .prose { margin: 0 auto; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 56px; padding-top: 28px; border-top: 1px solid var(--ln); }
  .pager a { text-decoration: none; display: flex; flex-direction: column; gap: 4px; padding: 14px 0; font-weight: 700; }
  .pager a:hover span { text-decoration: underline; text-underline-offset: 3px; } .pager small { color: var(--muted); font-weight: 500; } .pager .r { text-align: right; }
  h2 { margin-bottom: 28px; }
  @media (max-width: 560px) { .pager { grid-template-columns: 1fr; } .pager .r { text-align: left; } }
</style>
