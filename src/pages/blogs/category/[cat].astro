---
import Base from '../../../layouts/Base.astro';
import BlogCard from '../../../components/BlogCard.astro';
import { getPosts, getPostCategories } from '../../../lib/wp';

export async function getStaticPaths() {
  const [posts, cats] = await Promise.all([getPosts(), getPostCategories()]);
  return cats.map((c) => ({ params: { cat: c.slug }, props: { c, cats, posts: posts.filter((p) => p.categories.some((x) => x.slug === c.slug)) } }));
}
const { c, cats, posts } = Astro.props;
---
<Base title={`${c.name} articles`} description={`Roast Journal articles about ${c.name}.`}>
  <header class="page-head">
    <div class="frame">
      <p class="crumb"><a href="/blogs/">The Roast Journal</a></p>
      <h1>{c.name}</h1>
      <p>{posts.length} {posts.length === 1 ? 'article' : 'articles'}</p>
    </div>
  </header>
  <section class="band">
    <div class="frame">
      <nav class="chips pad" aria-label="Article categories">
        <a href="/blogs/">All</a>
        {cats.map((x) => <a href={`/blogs/category/${x.slug}/`} aria-current={x.slug === c.slug ? 'page' : undefined}>{x.name}</a>)}
      </nav>
      <div class="grid3">{posts.map((p) => <BlogCard post={p} />)}</div>
    </div>
  </section>
</Base>
<style>
  .band { padding-top: 40px; }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 32px; }
  .chips a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border: 2px solid var(--ink); border-radius: 999px; text-decoration: none; font-weight: 600; }
  .chips a:hover, .chips a[aria-current] { background: var(--ink); color: var(--yellow); }
</style>
