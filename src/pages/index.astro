---
import Site from '../layouts/Site.astro';
import { homeGuidesHtml, homeJournalHtml } from '../lib/site.mjs';
---
<Site title="Daily Grind Roastery | Freshly roasted coffee beans in Laguna" description="Small-batch roasted coffee beans for home brewers and cafés. Single origins, house blends and drip coffee, roasted in San Pedro City, Laguna. Retail and wholesale." path="/" image="/assets/img/og.jpg" preload="/assets/img/m-hero-roaster.webp">
    <!-- Hero -->
    <section class="hero hero--photo" id="top">
      <img class="hero-img" src="/assets/img/m-hero-roaster.webp" width="1920" height="1072" fetchpriority="high" alt="A roaster's sample scoop holding freshly roasted coffee beans over the roasting drum">
      <div class="wrap hero-inner">
        <div class="hero-copy">
          <p class="status"><span class="live" aria-hidden="true"></span>Small-batch roastery · San Pedro City, Laguna</p>
          <h1>Expertly roasted. Ready for every <span class="mark">brew.</span></h1>
          <p class="lead">Small-batch roasted coffee beans for home brewers and café owners, roasted in San Pedro City, Laguna.</p>
          <div class="btn-row">
            <a class="btn" href="/coffee-beans-retail/">Shop coffee</a>
            <a class="btn btn-ghost" href="/wholesale-coffee-beans/">Wholesale</a>
          </div>
        </div>
      </div>
    </section>
    <div class="facts">
      <ul class="wrap">
        <li>Roasted in small batches</li>
        <li>Single origins and blends</li>
        <li>Pick your size and grind</li>
        <li>Retail and wholesale</li>
      </ul>
    </div>

    <!-- Brew method: the one interaction -->
    <section class="section brew" id="brew">
      <div class="wrap brew-grid">
        <div class="brew-text">
          <p class="eyebrow reveal"><span>01</span>Brew</p>
          <h2 class="reveal">How do you brew?</h2>
          <div class="methods" role="group" aria-label="Brew method">
            <button type="button" class="method" aria-pressed="true" data-m="espresso" data-i="01">Espresso</button>
            <button type="button" class="method" aria-pressed="false" data-m="pourover" data-i="02">Pour-over</button>
            <button type="button" class="method" aria-pressed="false" data-m="press" data-i="03">French press</button>
            <button type="button" class="method" aria-pressed="false" data-m="cold" data-i="04">Cold brew</button>
          </div>
          <div class="advice" aria-live="polite">
            <div class="adv" data-for="espresso"><p><span class="label">Try</span> <strong>Caramelo</strong>, a house blend with caramel, nuts and a little fruit. Ask for a fine grind.</p><a class="link" href="/caramelo/">Get Caramelo, from ₱395</a></div>
            <div class="adv" data-for="pourover"><p><span class="label">Try</span> <strong>Ethiopia Yirgacheffe</strong>, with fruits, berries, chocolate, citrus and florals. Ask for a medium-fine grind.</p><a class="link" href="/ethiopia-yirgacheffe/">Get Yirgacheffe, from ₱520</a></div>
            <div class="adv" data-for="press"><p><span class="label">Try</span> <strong>Sumatra Mandheling</strong>, a single origin for a full cup. Ask for a coarse grind.</p><a class="link" href="/sumatra-mandheling/">Get Sumatra, from ₱420</a></div>
            <div class="adv" data-for="cold"><p><span class="label">Try</span> <strong>Nicaragua SHG</strong>, with nuts and vanilla bean, smooth over ice. Ask for a coarse grind.</p><a class="link" href="/nicaragua-shg/">Get Nicaragua, from ₱420</a></div>
          </div>
        </div>
        <div class="brew-pics" aria-hidden="true">
          <img class="bp" data-for="espresso" src="/assets/img/m-espresso.webp" alt="" width="900" height="900" loading="lazy">
          <img class="bp" data-for="pourover" src="/assets/img/m-pourover.webp" alt="" width="900" height="900" loading="lazy">
          <img class="bp" data-for="press" src="/assets/img/m-press.webp" alt="" width="900" height="900" loading="lazy">
          <img class="bp" data-for="cold" src="/assets/img/m-cold.webp" alt="" width="900" height="900" loading="lazy">
        </div>
      </div>
    </section>

    <!-- Beans -->
    <section class="section beans" id="beans">
      <div class="wrap">
        <p class="eyebrow reveal"><span>02</span>Beans</p>
        <div class="head reveal">
          <h2>Our best-selling roasts</h2>
          <a class="link" href="/coffee-beans-retail/">View all coffee</a>
        </div>
        <ul class="bean-grid">
          <li class="reveal"><a href="/nicaragua-shg/"><span class="pic"><img src="/assets/img/p-nicaragua.webp" alt="" width="640" height="640" loading="lazy"></span><span class="kind">Single origin</span><h3>Nicaragua SHG</h3><span class="price">From ₱420</span></a></li>
          <li class="reveal"><a href="/ethiopia-yirgacheffe/"><span class="pic"><img src="/assets/img/p-yirgacheffe.webp" alt="" width="640" height="640" loading="lazy"></span><span class="kind">Single origin</span><h3>Ethiopia Yirgacheffe</h3><span class="price">From ₱520</span></a></li>
          <li class="reveal"><a href="/sumatra-mandheling/"><span class="pic"><img src="/assets/img/p-sumatra.webp" alt="" width="640" height="640" loading="lazy"></span><span class="kind">Single origin</span><h3>Sumatra Mandheling</h3><span class="price">From ₱420</span></a></li>
          <li class="reveal"><a href="/guatemala/"><span class="pic"><img src="/assets/img/p-guatemala.webp" alt="" width="640" height="640" loading="lazy"></span><span class="kind">Single origin</span><h3>Guatemala</h3><span class="price">From ₱420</span></a></li>
          <li class="reveal"><a href="/caramelo/"><span class="pic"><img src="/assets/img/p-caramelo.webp" alt="" width="640" height="640" loading="lazy"></span><span class="kind">House blend</span><h3>Caramelo</h3><span class="price">From ₱395</span></a></li>
          <li class="reveal"><a href="/bliss/"><span class="pic"><img src="/assets/img/p-bliss.webp" alt="" width="640" height="640" loading="lazy"></span><span class="kind">House blend</span><h3>Bliss</h3><span class="price">From ₱340</span></a></li>
        </ul>
        <p class="more-line reveal">Also in the store: <a class="link" href="/coffee-beans-retail/drip-coffee/">Drip coffee from ₱45</a></p>
      </div>
    </section>

    <!-- Wholesale -->
    <section class="section cream wholesale" id="wholesale">
      <div class="wrap ws">
        <div class="ws-text">
          <p class="eyebrow reveal"><span>03</span>Wholesale</p>
          <h2 class="big-h reveal">Coffee for your café.</h2>
          <p class="lede reveal">Cafés, retailers and corporate clients get steady supply from one roastery.</p>
          <div class="btn-row reveal">
            <a class="btn" href="/wholesale-coffee-beans/">Shop wholesale</a>
            <a class="btn btn-ghost" href="#contact">Ask about custom branding</a>
          </div>
        </div>
        <figure class="ws-pic reveal"><img src="/assets/img/m-cafe.webp" width="1200" height="1490" loading="lazy" alt="A barista's hands pouring steamed milk into a white cup at a bright café counter"></figure>
      </div>
      <ul class="wrap three">
        <li class="reveal"><span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3c1 4 5 6 5 11a5 5 0 0 1-10 0c0-2 1-3 2-4 0 2 1 3 2 3 0-4-2-5 1-10z"/></svg></span><h3>Small-batch roasting</h3><p>Every batch is roasted with care, so your café serves the same good cup each day.</p></li>
        <li class="reveal"><span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 8l9-5 9 5v8l-9 5-9-5zM3 8l9 5 9-5M12 13v8"/></svg></span><h3>Specialty coffee supply</h3><p>Single origins and house blends in bulk sizes, supplied to businesses nationwide.</p></li>
        <li class="reveal"><span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 12V4h8l10 10-8 8L3 12z"/><circle cx="7.5" cy="8.5" r="1.4"/></svg></span><h3>Custom coffee branding</h3><p>Custom blends, packaging and labeling to make the coffee yours.</p></li>
      </ul>
    </section>

    <!-- Story -->
    <section class="story" id="story">
      <figure class="story-pic"><img src="/assets/img/m-roast.webp" width="1200" height="1490" loading="lazy" alt="Freshly roasted coffee beans pouring from a steaming cooling tray"></figure>
      <div class="story-text">
        <p class="eyebrow reveal"><span>04</span>Story</p>
        <h2 class="reveal">Great coffee, <span class="mark">roasted with care.</span></h2>
        <p class="lede reveal">We combine expertise, dedication and a love for coffee to craft exceptional roasts, single origins and signature blends.</p>
        <p class="muted reveal">Every roast starts at our roastery in San Pedro City, Laguna, and ends in your cup or your café.</p>
        <a class="link reveal" href="/about-us/">Read our story</a>
      </div>
    </section>

    <!-- Learn -->
    <section class="section learn" id="learn">
      <div class="wrap"><p class="eyebrow reveal"><span>05</span>Learn</p></div>
      <div class="wrap learn-grid">
        <div>
          <h2 class="reveal">Brewing guides</h2>
          <ul class="rows"><Fragment set:html={homeGuidesHtml} /></ul>
        </div>
        <div>
          <h2 class="reveal">The Roast Journal</h2>
          <ul class="rows"><Fragment set:html={homeJournalHtml} /></ul>
          <p class="more-line reveal"><a class="link" href="/blogs/">All articles</a> &nbsp;·&nbsp; <a class="link" href="/brewing-guides/">All brewing guides</a></p>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="section cream" id="contact">
      <div class="wrap contact">
        <div class="reveal">
          <p class="eyebrow"><span>06</span>Contact</p>
          <h2>Visit or get in touch</h2>
          <p class="muted">Questions about an order, wholesale supply or a custom blend? Send a message or call.</p>
          <dl class="details">
            <dt>Roastery</dt>
            <dd>GF FilWeb Asia Bldg., Maharlika Drive, USPS,<br>San Pedro City, Laguna, Philippines<br><a href="https://www.google.com/maps/search/?api=1&amp;query=GF+FilWeb+Asia+Bldg+Maharlika+Drive+San+Pedro+Laguna+Philippines">Open in Google Maps</a></dd>
            <dt>Call</dt>
            <dd><a href="tel:+639171663693">0917-1663693</a><br><a href="tel:+63288694428">02-8869-4428</a></dd>
            <dt>Hours</dt>
            <dd>Monday to Saturday, 8:00 am to 5:00 pm<br><span class="open-line" data-open-line></span></dd>
          </dl>
        </div>
        <form class="form reveal" id="contact-form" novalidate>
          <label for="f-name">Name</label>
          <input id="f-name" name="name" autocomplete="name" required>
          <label for="f-email">Email</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required>
          <label for="f-msg">Message</label>
          <textarea id="f-msg" name="message" rows="4" required></textarea>
          <p class="error" id="form-error" role="alert" hidden>Please fill in your name, a valid email and a message.</p>
          <button class="btn" type="submit">Send message</button>
          <p class="success" id="form-ok" role="status" hidden>Your email app is opening with your message ready to send. If nothing opens, call 0917-1663693.</p>
        </form>
      </div>
    </section>
  </Site>
