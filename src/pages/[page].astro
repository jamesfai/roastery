---
import Base from '../layouts/Base.astro';
import { getPage, plain } from '../lib/wp';

export async function getStaticPaths() {
  const slugs = ['about-us', 'faqs', 'brewing-guides', 'shipping-policy', 'refund-policy', 'privacy-policy', 'terms-and-conditions'];
  const out = [];
  for (const slug of slugs) {
    const page = await getPage(slug);
    if (page) out.push({ params: { page: slug }, props: { page } });
  }
  return out;
}
const { page } = Astro.props;
// Drop inline scripts/styles that came from WordPress page builders.
const html = page.content.rendered
  .replace(/<script[\s\S]*?<\/script>/gi, '')
  .replace(/<style[\s\S]*?<\/style>/gi, '');
---
<Base title={plain(page.title.rendered)} description={plain(html).slice(0, 160)}>
  <header class="page-head"><div class="frame"><h1 set:html={page.title.rendered} /></div></header>
  <section class="band"><div class="frame pad"><article class="prose" set:html={html} /></div></section>
</Base>
<style>
  .band { padding: clamp(40px, 6vw, 80px) 0; }
</style>
