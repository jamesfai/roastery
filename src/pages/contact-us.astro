---
import Base from '../layouts/Base.astro';
---
<Base title="Contact Us" description="Get in touch with Daily Grind Roastery for retail and wholesale coffee enquiries.">
  <header class="page-head"><div class="frame"><h1>Contact us</h1><p>Questions about an order, wholesale supply or a custom blend? We'd love to hear from you.</p></div></header>
  <section class="band">
    <div class="frame">
      <div class="cols">
        <div class="info pad">
          <h2>Visit the roastery</h2>
          <address>GF FilWeb Asia Bldg., Maharlika Drive, USPS,<br />San Pedro City, Laguna, Philippines</address>
          <h3>Call</h3>
          <p>0917-1663693<br />02-8869-4428</p>
          <h3>Hours</h3>
          <p>Monday to Saturday, 8:00 am – 5:00 pm</p>
          <p><a href="https://facebook.com/DailyGrindRoastery/" rel="noopener">Facebook</a> and <a href="https://instagram.com/dailygrindroastery/" rel="noopener">Instagram</a></p>
        </div>
        <div class="form pad">
          <h2>Send a message</h2>
          <p class="muted">This form isn't connected yet. It will post to the WordPress form handler before launch.</p>
          <form onsubmit="return false">
            <label for="n">Name</label><input id="n" name="name" autocomplete="name" required />
            <label for="e">Email</label><input id="e" type="email" name="email" autocomplete="email" required />
            <label for="m">Message</label><textarea id="m" name="message" rows="5" required></textarea>
            <button class="btn" disabled>Send message</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .band { padding: 0; }
  .cols { display: grid; grid-template-columns: 1fr 1.4fr; }
  .info, .form { padding-top: clamp(36px, 6vw, 72px); padding-bottom: clamp(36px, 6vw, 72px); }
  address { font-style: normal; margin-bottom: 1.6em; }
  label { display: block; font-weight: 600; margin: 18px 0 6px; }
  h2 { font-size: 1.6rem; }
  input, textarea { display: block; width: 100%; padding: 12px 14px; border: 1.5px solid var(--ink); border-radius: 6px; font: inherit; background: var(--white); }
  button { margin-top: 22px; } button[disabled] { opacity: .5; cursor: not-allowed; }
  a { text-underline-offset: 3px; }
  @media (max-width: 800px) { .cols { grid-template-columns: 1fr; } }
</style>
