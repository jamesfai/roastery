---
import { STORE } from '../lib/site.mjs';
---
<footer class="site-footer">
  <div class="wrap foot-grid">
    <div class="foot-brand">
      <img src="/assets/img/logo.webp" alt="Daily Grind Roastery" width="123" height="44" loading="lazy" />
      <p>Expertly roasted coffee beans for every brew.</p>
      <ul class="social">
        <li><a href="https://facebook.com/DailyGrindRoastery/" rel="noopener" aria-label="Daily Grind Roastery on Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H7v4h3v7h4v-7h3l1-4h-4V8z" /></svg></a></li>
        <li><a href="https://instagram.com/dailygrindroastery/" rel="noopener" aria-label="Daily Grind Roastery on Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm5 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm5.5-1.5h.01" /></svg></a></li>
      </ul>
    </div>
    <nav aria-label="Shop">
      <h3>Shop</h3>
      <ul>
        <li><a href="/coffee-beans-retail/">Retail coffee</a></li>
        <li><a href="/coffee-beans-retail/drip-coffee/">Drip coffee</a></li>
        <li><a href="/wholesale-coffee-beans/">Wholesale</a></li>
        <li><a href={`${STORE}/account/`}>My account</a></li>
      </ul>
    </nav>
    <nav aria-label="Company">
      <h3>Company</h3>
      <ul>
        <li><a href="/about-us/">About us</a></li>
        <li><a href="/brewing-guides/">Brewing guides</a></li>
        <li><a href="/blogs/">The Roast Journal</a></li>
        <li><a href="/faqs/">FAQs</a></li>
        <li><a href="/contact-us/">Contact us</a></li>
      </ul>
    </nav>
    <nav aria-label="Policies">
      <h3>Policies</h3>
      <ul>
        <li><a href="/shipping-policy/">Shipping</a></li>
        <li><a href="/refund-policy/">Refunds</a></li>
        <li><a href="/privacy-policy/">Privacy</a></li>
        <li><a href="/terms-and-conditions/">Terms</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap legal"><p>© <span id="year">2026</span> Daily Grind Roastery. All rights reserved.</p></div>
</footer>
