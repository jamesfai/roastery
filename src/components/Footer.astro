---
import { WP_URL } from '../lib/wp';
const logo = `${WP_URL}/wp-content/uploads/2024/09/daily-grind-roastery-logo.webp`;
const year = new Date().getFullYear();
---
<footer>
  <div class="frame lines">
    <div class="cols">
      <div class="col brand">
        <img src={logo} alt="Daily Grind Roastery" width="123" height="44" />
        <p class="muted">© {year} Daily Grind Roastery. All rights reserved.</p>
        <p class="muted">GF FilWeb Asia Bldg., Maharlika Drive, USPS, San Pedro City, Laguna, Philippines</p>
      </div>
      <nav class="col" aria-label="Shop">
        <h3>Shop</h3>
        <ul>
          <li><a href="/coffee-beans-retail/">Retail</a></li>
          <li><a href="/wholesale-coffee-beans/">Wholesale</a></li>
          <li><a href="/coffee-beans-retail/drip-coffee/">Drip Coffee</a></li>
          <li><a href="/brewing-guides/">Brewing Guides</a></li>
        </ul>
      </nav>
      <nav class="col" aria-label="Company">
        <h3>Company</h3>
        <ul>
          <li><a href="/about-us/">About Us</a></li>
          <li><a href="/faqs/">FAQs</a></li>
          <li><a href="/contact-us/">Contact Us</a></li>
          <li><a href={`${WP_URL}/blogs/`}>The Roast Journal</a></li>
        </ul>
      </nav>
      <nav class="col" aria-label="Policies and social">
        <h3>Policies</h3>
        <ul>
          <li><a href="/shipping-policy/">Shipping</a></li>
          <li><a href="/refund-policy/">Refunds</a></li>
          <li><a href="/privacy-policy/">Privacy</a></li>
          <li><a href="/terms-and-conditions/">Terms</a></li>
        </ul>
        <h3 class="gap">Follow</h3>
        <ul>
          <li><a href="https://facebook.com/DailyGrindRoastery/" rel="noopener">Facebook</a></li>
          <li><a href="https://instagram.com/dailygrindroastery/" rel="noopener">Instagram</a></li>
        </ul>
        <p class="hours muted">Mon–Sat, 8:00 am – 5:00 pm<br />0917-1663693 · 02-8869-4428</p>
      </nav>
    </div>
  </div>
</footer>
<style>
  footer { border-top: 1px solid var(--ln); background: var(--white); }
  .cols { display: grid; grid-template-columns: repeat(4, 1fr); }
  .col { padding: 48px var(--pad) 56px; }
  .brand img { height: 44px; width: auto; margin-bottom: 20px; }
  .brand p { font-size: .9rem; max-width: 28ch; }
  h3 { font-size: .95rem; margin-bottom: .8em; } .gap { margin-top: 1.6em; }
  ul { list-style: none; padding: 0; margin: 0; }
  li a { display: inline-block; padding: 5px 0; text-decoration: none; font-size: .95rem; }
  li a:hover { background: var(--yellow); }
  .hours { font-size: .85rem; margin-top: 1.4em; }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .cols { grid-template-columns: 1fr; } .col { padding: 28px var(--pad); border-top: 1px solid var(--ln); } }
</style>
