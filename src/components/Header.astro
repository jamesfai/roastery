---
import { NAV, STORE } from '../lib/site.mjs';
const { path = '/' } = Astro.props;
const current = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="site-header" id="top-bar">
  <div class="wrap bar">
    <a class="logo" href="/" aria-label="Daily Grind Roastery, home"><img src="/assets/img/logo.webp" alt="Daily Grind Roastery" width="123" height="44" /></a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav"><span class="sr">Menu</span><i></i></button>
    <nav id="site-nav" aria-label="Main">
      <ul>
        {NAV.map((n) => (
          <li class={n.sub ? 'has-sub' : undefined}>
            <a href={n.href} aria-current={current(n.href) ? 'page' : undefined}>{n.label}</a>
            {n.sub && <ul class="sub">{n.sub.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>}
          </li>
        ))}
      </ul>
      <a class="cart" href={`${STORE}/cart/`}>Cart</a>
    </nav>
  </div>
</header>
