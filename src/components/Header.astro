---
import { WP_URL, wcUrl } from '../lib/wp';
const logo = `${WP_URL}/wp-content/uploads/2024/09/daily-grind-roastery-logo.webp`;
const nav = [
  { label: 'Retail', href: '/coffee-beans-retail/', children: [
    { label: 'Single Origin', href: '/coffee-beans-retail/single-origin/' },
    { label: 'House Blend', href: '/coffee-beans-retail/house-blend/' },
    { label: 'Drip Coffee', href: '/coffee-beans-retail/drip-coffee/' } ] },
  { label: 'Wholesale', href: '/wholesale-coffee-beans/', children: [
    { label: 'Single Origin', href: '/wholesale-coffee-beans/single-origin/' },
    { label: 'House Blend', href: '/wholesale-coffee-beans/house-blend/' } ] },
  { label: 'Brewing Guides', href: '/brewing-guides/' },
  { label: 'About Us', href: '/about-us/' },
  { label: 'Contact', href: '/contact-us/' },
];
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="logo" aria-label="Daily Grind Roastery home"><img src={logo} alt="Daily Grind Roastery" height="48" /></a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle menu" />
    <label for="nav-toggle" class="burger" aria-hidden="true"><span></span></label>
    <nav>
      <ul>
        {nav.map((n) => (
          <li class={n.children ? 'has-sub' : ''}>
            <a href={n.href}>{n.label}</a>
            {n.children && <ul class="sub">{n.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>}
          </li>
        ))}
        <li><a href={wcUrl.account}>My Account</a></li>
        <li><a class="btn cart" href={wcUrl.cart}>Cart</a></li>
      </ul>
    </nav>
  </div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(255,250,243,.94); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; min-height: 72px; gap: 20px; }
  .logo img { height: 48px; width: auto; }
  nav > ul { display: flex; align-items: center; gap: 4px; list-style: none; margin: 0; padding: 0; }
  nav a { text-decoration: none; padding: 8px 12px; font-weight: 500; font-size: .95rem; border-radius: 8px; display: block; }
  nav a:hover { color: var(--caramel-dark); }
  .btn.cart { padding: .5em 1.2em; color: #fff; margin-left: 6px; }
  .has-sub { position: relative; }
  .sub { position: absolute; top: 100%; left: 0; min-width: 190px; background: var(--paper); border: 1px solid var(--line); border-radius: 10px; padding: 6px; list-style: none; margin: 0; box-shadow: 0 12px 30px rgba(36,22,15,.12); opacity: 0; visibility: hidden; transform: translateY(6px); transition: .18s; }
  .has-sub:hover .sub, .has-sub:focus-within .sub { opacity: 1; visibility: visible; transform: none; }
  .nav-toggle, .burger { display: none; }
  @media (max-width: 900px) {
    .burger { display: block; cursor: pointer; padding: 12px; }
    .burger span, .burger span::before, .burger span::after { display: block; width: 24px; height: 2px; background: var(--espresso); position: relative; content: ''; }
    .burger span::before { position: absolute; top: -7px; } .burger span::after { position: absolute; top: 7px; }
    nav { display: none; position: absolute; top: 100%; left: 0; right: 0; background: var(--paper); border-bottom: 1px solid var(--line); padding: 10px 20px 20px; max-height: 80vh; overflow: auto; }
    .nav-toggle:checked ~ nav { display: block; }
    nav > ul { flex-direction: column; align-items: stretch; }
    .sub { position: static; opacity: 1; visibility: visible; transform: none; border: 0; box-shadow: none; padding: 0 0 0 14px; }
  }
</style>
