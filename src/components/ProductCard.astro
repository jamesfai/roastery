---
import { fromPrice, wcUrl, type WCProduct } from '../lib/wp';
interface Props { product: WCProduct }
const { product: p } = Astro.props;
const img = p.images[0];
const simple = p.type === 'simple' && p.is_purchasable;
const tag = p.categories.find((c) => !['retail', 'wholesale'].includes(c.slug))?.name ?? p.categories[0]?.name;
---
<article class="card">
  <a class="media" href={`/products/${p.slug}/`} tabindex="-1" aria-hidden="true">
    <img src={img.src} alt="" loading="lazy" width="600" height="600" />
  </a>
  <div class="body">
    <span class="tag">{tag}</span>
    <h3><a href={`/products/${p.slug}/`}>{p.name}</a></h3>
    <p class="price">{fromPrice(p)}</p>
    {p.is_in_stock
      ? <a class="btn sm" href={simple ? wcUrl.addToCart(p.id) : `/products/${p.slug}/`}>{simple ? 'Add to cart' : 'Choose options'}</a>
      : <span class="out">Out of stock</span>}
  </div>
</article>
<style>
  .card { display: flex; flex-direction: column; background: var(--white); color: var(--ink); border: 1px solid var(--ln); border-radius: var(--radius); overflow: hidden; height: 100%; transition: box-shadow .2s, transform .2s; }
  .card:hover { box-shadow: 0 14px 30px rgba(0,0,0,.18); transform: translateY(-3px); }
  .media { display: block; aspect-ratio: 1; background: var(--mist); overflow: hidden; }
  .media img { width: 100%; height: 100%; object-fit: cover; mix-blend-mode: multiply; }
  .body { padding: 16px 18px 20px; display: flex; flex-direction: column; align-items: flex-start; gap: 6px; flex: 1; }
  h3 { margin: 4px 0 0; } h3 a { text-decoration: none; } h3 a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .price { margin: 0 0 12px; font-weight: 700; font-size: 1.15rem; }
  .body .btn { margin-top: auto; }
  .out { font-weight: 600; color: var(--muted); }
  @media (prefers-reduced-motion: reduce) { .card { transition: none; } .card:hover { transform: none; } }
</style>
