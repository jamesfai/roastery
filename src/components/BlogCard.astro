---
import { formatDate, type BlogPost } from '../lib/wp';
interface Props { post: BlogPost; featured?: boolean }
const { post, featured = false } = Astro.props;
const href = `/blogs/${post.slug}/`;
---
<article class:list={['post', { featured }]}>
  <a class="media" href={href} tabindex="-1" aria-hidden="true">
    {post.image
      ? <img src={post.image.src} alt="" loading={featured ? 'eager' : 'lazy'} width="800" height="520" />
      : <span class="ph" />}
  </a>
  <div class="body">
    <p class="meta">
      {post.categories[0] && <span class="tag">{post.categories[0].name}</span>}
      <time datetime={post.date}>{formatDate(post.date)}</time>
      <span>{post.readMinutes} min read</span>
    </p>
    <h3><a href={href}>{post.title}</a></h3>
    <p class="excerpt">{post.excerpt}</p>
    <a class="more" href={href}>Read article<span class="sr">: {post.title}</span></a>
  </div>
</article>
<style>
  .post { display: flex; flex-direction: column; background: var(--white); color: var(--ink); border: 1px solid var(--ln); border-radius: var(--radius); overflow: hidden; height: 100%; }
  .media { display: block; aspect-ratio: 3 / 2; background: var(--mist); overflow: hidden; }
  .media img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  .post:hover .media img { transform: scale(1.04); }
  .ph { display: block; width: 100%; height: 100%; background: radial-gradient(circle at center, var(--yellow) 0 14px, transparent 15px 26px, var(--yellow) 27px 29px, transparent 30px), var(--ink); }
  .body { padding: 20px 22px 24px; display: flex; flex-direction: column; flex: 1; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; font-size: .85rem; color: var(--muted); margin: 0 0 12px; }
  h3 { font-size: 1.3rem; line-height: 1.2; letter-spacing: -0.015em; margin: 0 0 .5em; }
  h3 a { text-decoration: none; } h3 a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .excerpt { color: var(--muted); font-size: .95rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 1em; }
  .more { margin-top: auto; align-self: flex-start; font-weight: 700; text-decoration: none; border-bottom: 2px solid var(--yellow); }
  .more:hover { background: var(--yellow); }
  .featured { display: grid; grid-template-columns: 1.3fr 1fr; }
  .featured .media { aspect-ratio: auto; min-height: 340px; }
  .featured .body { padding: clamp(24px, 4vw, 48px); justify-content: center; }
  .featured h3 { font-size: clamp(1.7rem, 3vw, 2.4rem); }
  .featured .excerpt { -webkit-line-clamp: 4; font-size: 1.05rem; }
  @media (max-width: 800px) { .featured { grid-template-columns: 1fr; } .featured .media { min-height: 0; aspect-ratio: 3 / 2; } }
  @media (prefers-reduced-motion: reduce) { .media img { transition: none; } }
</style>
